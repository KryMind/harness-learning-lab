{
  "name": "harness-learning-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Harness Learning Lab —— 源码驱动的 DeepSeek Harness 学习地图（可点击、可追踪、可运行）",
  "type": "module",
  "scripts": {
    "scan": "tsx scripts/scan.ts",
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @hll/server dev\" \"pnpm --filter @hll/web dev\"",
    "dev:server": "pnpm --filter @hll/server dev",
    "dev:web": "pnpm --filter @hll/web dev",
    "build": "pnpm --filter @hll/web build",
    "start": "pnpm --filter @hll/server start",
    "typecheck": "tsc -p server && tsc -p web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
